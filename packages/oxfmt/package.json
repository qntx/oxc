{
  "name": "@qntx/oxfmt",
  "version": "1.0.0",
  "description": "Shareable Oxfmt config for Vite+ apps and TypeScript libraries",
  "keywords": [
    "format",
    "oxc",
    "oxfmt",
    "typescript",
    "vite+",
    "vite-plus"
  ],
  "homepage": "https://github.com/qntx/oxc#readme",
  "bugs": {
    "url": "https://github.com/qntx/oxc/issues"
  },
  "license": "MIT",
  "author": "QuantX <x@qntx.fun>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/oxc.git",
    "directory": "packages/oxfmt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
