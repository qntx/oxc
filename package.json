{
  "name": "oxlint",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && bun test && vp run -r build",
    "lint": "vp check",
    "build": "vp run -r build",
    "test": "bun test",
    "check": "vp check",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1"
  }
}
