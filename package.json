{
  "name": "@qntx/oxc-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/oxc.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "vp check",
    "typecheck": "vp run --filter \"./packages/*\" typecheck && tsc --noEmit",
    "build": "vp run -r build",
    "test": "vp run --filter \"./packages/*\" test && vp test",
    "ready": "bun run lint && bun run typecheck && bun run build && bun run test",
    "format": "vp check --fix",
    "release": "bumpp",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@qntx/tsconfig": "1.0.1",
    "@types/node": "26.6.6",
    "bumpp": "12.3.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
